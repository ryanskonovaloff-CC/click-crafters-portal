      "id": "meta-get-instagram-account-insig-49abc794",
      "name": "Meta - Get Instagram Account Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst accountResponse = $('Supabase Get - social_account').first().json;\nconst account = Array.isArray(accountResponse) ? accountResponse[0] : accountResponse;\nif (!account?.id) {\n  throw new Error('Could not find social account after upsert. Check social_accounts row, client_id, platform, and platform_account_id.');\n}\nconst profile = $('Meta - Get Instagram Profile').first().json || {};\nconst payload = $input.first().json || {};\nconst now = new Date().toISOString();\nconst dateStart = config.date_start;\nconst dateEnd = config.date_end;\nconst byDate = new Map();\nfunction metricDateFromEndTime(endTime) {\n  if (!endTime) return dateEnd;\n  const d = new Date(endTime);\n  if (Number.isNaN(d.getTime())) return String(endTime).slice(0, 10);\n  d.setUTCDate(d.getUTCDate() - 1);\n  return d.toISOString().slice(0, 10);\n}\nfunction metricValue(value) {\n  if (value === null || value === undefined || typeof value === 'object') return null;\n  const n = Number(value);\n  return Number.isFinite(n) ? n : null;\n}\nfor (const metric of payload.data || []) {\n  const key = metric.name;\n  if (metric.total_value && Object.prototype.hasOwnProperty.call(metric.total_value, 'value')) {\n    if (!byDate.has(dateEnd)) byDate.set(dateEnd, {});\n    byDate.get(dateEnd)[key] = metricValue(metric.total_value.value);\n    continue;\n  }\n  for (const value of metric.values || []) {\n    const day = metricDateFromEndTime(value.end_time);\n    if (day < dateStart || day > dateEnd) continue;\n    if (!byDate.has(day)) byDate.set(day, {});\n    byDate.get(day)[key] = metricValue(value.value);\n  }\n}\nif (byDate.size === 0) byDate.set(dateEnd, {});\nconst rows = [...byDate.entries()].map(([metric_date, m]) => ({\n  social_account_id: account.id,\n  client_id: config.client_id,\n  metric_date,\n  followers_total: profile.followers_count ?? null,\n  followers_gained: null,\n  unfollows: null,\n  net_follower_growth: null,\n  reach_total: m.reach ?? null,\n  reach_organic: null,\n  reach_paid: null,\n  impressions_total: m.views ?? m.impressions ?? null,\n  impressions_organic: null,\n  impressions_paid: null,\n  accounts_engaged: m.accounts_engaged ?? null,\n  profile_visits: m.profile_views ?? null,\n  website_clicks: m.website_clicks ?? null,\n  total_interactions: m.total_interactions ?? null,\n  content_published: null,\n  raw_payload: { profile, insights: payload },\n  updated_at: now\n}));\nreturn [{ json: { rows } }];"
      },
