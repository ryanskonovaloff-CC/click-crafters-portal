      "id": "meta-insights-instagram-paid-dai-4d097510",
      "name": "Meta Insights - Instagram Paid Daily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst payload = $input.first().json || {};\nconst now = new Date().toISOString();\nfunction num(v) { const n = Number(v || 0); return Number.isFinite(n) ? n : 0; }\nfunction actionValue(actions, names) {\n  if (!Array.isArray(actions)) return 0;\n  return actions.filter((a) => names.includes(a.action_type)).reduce((sum, a) => sum + num(a.value), 0);\n}\nconst rows = (payload.data || [])\n  .filter((row) => (row.publisher_platform || '').toLowerCase() === 'instagram')\n  .map((row) => {\n    const actions = row.actions || [];\n    const actionValues = row.action_values || [];\n    const videoViews = actionValue(actions, ['video_view', 'onsite_conversion.video_view']);\n    const conversions = actionValue(actions, ['purchase','omni_purchase','offsite_conversion.fb_pixel_purchase','onsite_web_purchase']);\n    const conversionValue = actionValue(actionValues, ['purchase','omni_purchase','offsite_conversion.fb_pixel_purchase','onsite_web_purchase']);\n    const placementKey = 'instagram:' + (row.platform_position || 'unknown');\n    return {\n      client_id: config.client_id,\n      metric_date: row.date_start || config.date_end,\n      source_platform: 'Meta Ads',\n      publisher_platform: 'instagram',\n      platform_position: row.platform_position || null,\n      placement: row.platform_position ? 'Instagram ' + row.platform_position : 'Instagram',\n      placement_key: placementKey,\n      campaign_id: String(row.campaign_id || 'unknown'),\n      campaign_name: row.campaign_name || null,\n      adset_id: String(row.adset_id || 'unknown'),\n      adset_name: row.adset_name || null,\n      ad_id: String(row.ad_id || 'unknown'),\n      ad_name: row.ad_name || null,\n      spend: num(row.spend),\n      reach: row.reach != null ? num(row.reach) : null,\n      impressions: row.impressions != null ? num(row.impressions) : null,\n      clicks: row.clicks != null ? num(row.clicks) : null,\n      inline_link_clicks: row.inline_link_clicks != null ? num(row.inline_link_clicks) : null,\n      video_views: videoViews,\n      engagements: actionValue(actions, ['post_engagement','page_engagement','like','comment','post_reaction','post','onsite_conversion.post_save']),\n      profile_visits: actionValue(actions, ['profile_visit','onsite_conversion.messaging_conversation_started_7d']),\n      follows: actionValue(actions, ['onsite_conversion.follow','follow']),\n      conversions,\n      conversion_value: conversionValue,\n      raw_payload: row,\n      updated_at: now\n    };\n  });\nreturn [{ json: { rows } }];"
      },
      "id": "normalize-instagram-paid-placeme-4d143935",
      "name": "Normalize Instagram Paid Placement Metrics",
