      "id": "meta-get-instagram-media-list-20691d00",
      "name": "Meta - Get Instagram Media List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst accountResponse = $('Supabase Get - social_account').first().json;\nconst account = Array.isArray(accountResponse) ? accountResponse[0] : accountResponse;\nconst mediaPayload = $input.first().json || {};\nif (!account?.id) throw new Error('Could not find social account after upsert. Check Supabase Get - social_account.');\nconst now = new Date().toISOString();\nconst rows = (mediaPayload.data || []).map((media) => ({\n  social_account_id: account.id,\n  client_id: config.client_id,\n  platform_media_id: String(media.id),\n  media_type: media.media_type || null,\n  caption: media.caption || null,\n  media_url: media.media_url || null,\n  thumbnail_url: media.thumbnail_url || null,\n  permalink: media.permalink || null,\n  published_at: media.timestamp || null,\n  raw_payload: media,\n  updated_at: now\n}));\nreturn [{ json: { rows } }];"
      },
      "id": "normalize-social-media-content-7db117fd",
      "name": "Normalize Social Media Content",
