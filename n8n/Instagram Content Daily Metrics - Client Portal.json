      "id": "supabase-upsert-social-media-con-7bcb5ff4",
      "name": "Supabase Upsert - social_media_content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1860,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst contentResponse = $('Supabase Get - social_media_content').first().json;\nconst contentRows = Array.isArray(contentResponse) ? contentResponse : (contentResponse ? [contentResponse] : []);\nconst now = new Date().toISOString();\nconst metricDate = config.date_end;\nconst metricsToTry = ['reach','views','likes','comments','shares','saved','total_interactions','video_views','profile_activity'];\nfunction toNumber(v) {\n  if (v === null || v === undefined || typeof v === 'object') return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? n : null;\n}\nasync function fetchMetric(mediaId, metricName) {\n  const url = 'https://graph.facebook.com/' + config.graph_api_version + '/' + mediaId + '/insights';\n  try {\n    const res = await this.helpers.httpRequest({ method: 'GET', url, qs: { metric: metricName, access_token: config.meta_access_token }, json: true });\n    const item = (res.data || []).find((m) => m.name === metricName);\n    if (item?.total_value && Object.prototype.hasOwnProperty.call(item.total_value, 'value')) return toNumber(item.total_value.value);\n    const values = item?.values || [];\n    const latest = values[values.length - 1];\n    return toNumber(latest?.value);\n  } catch (error) {\n    return null;\n  }\n}\nconst rows = [];\nfor (const content of contentRows) {\n  if (!content.id || !content.platform_media_id) continue;\n  const m = {};\n  for (const metric of metricsToTry) {\n    m[metric] = await fetchMetric.call(this, content.platform_media_id, metric);\n  }\n  const reach = m.reach;\n  const interactions = m.total_interactions ?? [m.likes, m.comments, m.shares, m.saved].reduce((sum, v) => sum + Number(v || 0), 0);\n  rows.push({\n    social_media_content_id: content.id,\n    social_account_id: content.social_account_id,\n    client_id: config.client_id,\n    metric_date: metricDate,\n    reach_total: reach,\n    reach_organic: null,\n    reach_paid: null,\n    impressions_total: m.views ?? m.impressions,\n    impressions_organic: null,\n    impressions_paid: null,\n    likes: m.likes,\n    comments: m.comments,\n    shares: m.shares,\n    saves: m.saved,\n    total_interactions: interactions,\n    engagement_rate: reach && reach > 0 ? interactions / reach : null,\n    video_views: m.video_views ?? m.views,\n    average_watch_time_seconds: null,\n    profile_activity: m.profile_activity,\n    raw_payload: { platform_media_id: content.platform_media_id, metrics: m },\n    updated_at: now\n  });\n}\nreturn [{ json: { rows } }];"
      },
