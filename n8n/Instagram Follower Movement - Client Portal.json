      "id": "8132f39e-ecf5-4aa1-9e41-18463751cff0",
      "name": "Load Follower Snapshots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst inputItems = $input.all().map((item) => item.json);\nconst snapshots = inputItems.flatMap((item) =>\n  Array.isArray(item) ? item : Array.isArray(item.data) ? item.data : [item]\n);\nconst ordered = [...snapshots].sort((a, b) => {\n  const account = String(a.social_account_id).localeCompare(String(b.social_account_id));\n  return account || String(a.metric_date).localeCompare(String(b.metric_date));\n});\n\nconst priorFollowerTotal = new Map();\nconst updatedAt = new Date().toISOString();\nconst rows = [];\n\nfor (const snapshot of ordered) {\n  const followersTotal = Number(snapshot.followers_total);\n  if (!snapshot.social_account_id || !snapshot.metric_date || !Number.isFinite(followersTotal)) continue;\n\n  const prior = priorFollowerTotal.get(snapshot.social_account_id);\n  if (prior !== undefined) {\n    const netFollowerGrowth = followersTotal - prior;\n    rows.push({\n      client_id: config.client_id,\n      social_account_id: snapshot.social_account_id,\n      metric_date: snapshot.metric_date,\n      followers_total: followersTotal,\n      followers_gained: Math.max(netFollowerGrowth, 0),\n      unfollows: Math.max(-netFollowerGrowth, 0),\n      net_follower_growth: netFollowerGrowth,\n      updated_at: updatedAt\n    });\n  }\n\n  priorFollowerTotal.set(snapshot.social_account_id, followersTotal);\n}\n\nreturn [{ json: { rows, processed_snapshots: ordered.length, updated_metrics: rows.length } }];"
      },
      "id": "642f4412-4529-4dc2-9f4a-0a8087f82aed",
      "name": "Derive Follower Movement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        200
      ]
    },
    {
      "parameters": {
