        "url": "={{ $('Pipeline Config').first().json.supabase_url + '/rest/v1/social_account_daily_metrics' }}",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "social_account_id,metric_date"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Pipeline Config').first().json.supabase_service_role_key }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Pipeline Config').first().json.supabase_service_role_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.rows) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "08e2610e-05e4-4c01-8a1a-63f3f8792d55",
      "name": "Supabase Upsert - Follower Movement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        200
      ]
    },
    {
      "parameters": {
        "content": "## Follower movement\n\nRun after the Instagram Account Daily Metrics workflow. It derives daily movement from the stored follower-total snapshots:\n\n- gained = positive day-over-day difference\n- unfollows = negative day-over-day difference\n- net = current total minus prior total\n\nThis is an inferred net movement signal. Instagram does not expose authoritative daily gross follows and unfollows through this workflow. The first snapshot for an account has no prior-day comparison and is left unchanged.",
        "height": 300,
        "width": 460,
        "color": 5
      },
      "id": "bf2b898a-d345-4221-95d3-676389cf508b",
