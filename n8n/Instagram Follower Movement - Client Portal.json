    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Pipeline Config').first().json.supabase_url + '/rest/v1/social_account_daily_metrics' }}",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
