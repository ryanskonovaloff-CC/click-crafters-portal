      "id": "4a53f4db-32b1-4d0a-abf0-a6ea87cb8395",
      "name": "Meta - Get Instagram Media List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst accountResponse = $('Supabase Get - social_account').first().json;\nconst account = Array.isArray(accountResponse) ? accountResponse[0] : accountResponse;\nconst mediaPayload = $input.first().json || {};\nif (!account?.id) throw new Error('Could not find social account after upsert. Check Supabase Get - social_account.');\nconst now = new Date().toISOString();\nconst start = new Date(config.date_start + 'T00:00:00.000Z');\nconst end = new Date(config.date_end + 'T23:59:59.999Z');\nconst rows = (mediaPayload.data || [])\n  .filter((media) => {\n    if (!media.timestamp) return false;\n    const published = new Date(media.timestamp);\n    return published >= start && published <= end;\n  })\n  .map((media) => ({\n    social_account_id: account.id,\n    client_id: config.client_id,\n    platform_media_id: String(media.id),\n    media_type: media.media_type || null,\n    caption: media.caption || null,\n    media_url: media.media_url || null,\n    thumbnail_url: media.thumbnail_url || null,\n    permalink: media.permalink || null,\n    published_at: media.timestamp || null,\n    raw_payload: media,\n    updated_at: now\n  }));\nreturn [{ json: { rows, content_published: rows.length } }];"
      },
