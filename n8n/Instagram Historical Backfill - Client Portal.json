      "id": "463ea547-15c5-44a0-873e-4200fd331e61",
      "name": "Meta - Get Instagram Account Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst accountResponse = $('Supabase Get - social_account').first().json;\nconst account = Array.isArray(accountResponse) ? accountResponse[0] : accountResponse;\nif (!account?.id) {\n  throw new Error('Could not find social account after upsert. Check social_accounts row, client_id, platform, and platform_account_id.');\n}\nconst profile = $('Meta - Get Instagram Profile').first().json || {};\nconst payload = $input.first().json || {};\nconst now = new Date().toISOString();\nconst dateEnd = config.date_end;\nfunction metricValue(value) {\n  if (value === null || value === undefined || typeof value === 'object') return null;\n  const n = Number(value);\n  return Number.isFinite(n) ? n : null;\n}\nconst m = {};\nfor (const metric of payload.data || []) {\n  const key = metric.name;\n  if (metric.total_value && Object.prototype.hasOwnProperty.call(metric.total_value, 'value')) {\n    m[key] = metricValue(metric.total_value.value);\n    continue;\n  }\n  const values = metric.values || [];\n  const latest = values[values.length - 1];\n  m[key] = metricValue(latest?.value);\n}\nconst mediaList = $('Meta - Get Instagram Media List').first().json || {};\nconst start = new Date(config.date_start + 'T00:00:00.000Z');\nconst end = new Date(config.date_end + 'T23:59:59.999Z');\nconst contentPublished = (mediaList.data || []).filter((media) => {\n  if (!media.timestamp) return false;\n  const published = new Date(media.timestamp);\n  return published >= start && published <= end;\n}).length;\nconst rows = [{\n  social_account_id: account.id,\n  client_id: config.client_id,\n  metric_date: dateEnd,\n  followers_total: profile.followers_count ?? null,\n  followers_gained: null,\n  unfollows: null,\n  net_follower_growth: null,\n  reach_total: m.reach ?? null,\n  reach_organic: null,\n  reach_paid: null,\n  impressions_total: m.views ?? m.impressions ?? null,\n  impressions_organic: null,\n  impressions_paid: null,\n  accounts_engaged: m.accounts_engaged ?? null,\n  profile_visits: m.profile_views ?? null,\n  website_clicks: m.website_clicks ?? null,\n  total_interactions: m.total_interactions ?? null,\n  content_published: contentPublished,\n  raw_payload: { profile, insights: payload, backfill_window: { start: config.date_start, end: config.date_end } },\n  updated_at: now\n}];\nreturn [{ json: { rows } }];"
      },
