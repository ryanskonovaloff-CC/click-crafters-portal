        "url": "={{ 'https://graph.facebook.com/' + $('Pipeline Config').first().json.graph_api_version + '/' + $('Pipeline Config').first().json.instagram_business_account_id + '/media' }}",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,caption,media_type,media_url,thumbnail_url,permalink,timestamp"
