      "id": "meta-get-instagram-profile-600137e3",
      "name": "Meta - Get Instagram Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "const config = $('Pipeline Config').first().json;\nconst profile = $input.first().json || {};\nif (!profile.id || String(profile.id).startsWith('REPLACE_')) {\n  throw new Error('Instagram profile response did not include an id. Check instagram_business_account_id and access token permissions.');\n}\nconst now = new Date().toISOString();\nreturn [{ json: { rows: [{\n  client_id: config.client_id,\n  platform: 'instagram',\n  platform_account_id: String(profile.id),\n  username: profile.username || null,\n  display_name: profile.name || profile.username || null,\n  profile_url: profile.username ? 'https://www.instagram.com/' + profile.username.replace(/^@/, '') + '/' : null,\n  is_active: true,\n  last_synced_at: now,\n  raw_payload: profile,\n  updated_at: now\n}] } }];"
      },
      "id": "normalize-social-account-d43a9f3",
      "name": "Normalize Social Account",
